# Prose Craft Aid — staging environment variables
# Copy this file to `.env` for local staging development.
# Never commit real Supabase keys and never use production credentials here.

# Duplicated/staging Supabase project URL.
VITE_SUPABASE_URL=STAGING_SUPABASE_URL_HERE

# Duplicated/staging Supabase anon key.
VITE_SUPABASE_ANON_KEY=STAGING_SUPABASE_ANON_KEY_HERE

# Deprecated compatibility only. Prefer VITE_SUPABASE_ANON_KEY for new setup.
# VITE_SUPABASE_PUBLISHABLE_KEY=STAGING_SUPABASE_ANON_KEY_HERE
